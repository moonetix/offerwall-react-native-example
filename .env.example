# Copy to .env. Expo puts EXPO_PUBLIC_ values into the app bundle, so they are public.
# Never put the API key or the postback secret key here: those go in server/.env.

# The App ID from the top of your offerwall's settings page (24 lowercase hex characters).
EXPO_PUBLIC_MOONETIX_APP_ID=your-24-character-app-id
# Your server. 10.0.2.2 is your computer as seen from the Android emulator;
# use http://localhost:3000 on the iOS Simulator and https in production.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
